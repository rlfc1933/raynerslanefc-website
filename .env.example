# Rayners Lane FC — environment variables
# These are set in Netlify (Site settings → Environment variables), NOT committed.
# The .env file itself is gitignored.

# Required: a GitHub Personal Access Token with "Contents: write" permission
# on rlfc1933/raynerslanefc-website. Used server-side by
# netlify/functions/save-data.js so the admin panel can commit data files.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: overrides the admin PIN the save function checks (defaults to 19332026)
# ADMIN_PIN=19332026
